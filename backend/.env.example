# ===== Binance =====
# Create testnet keys at https://testnet.binance.vision/ (recommended)
# Or mainnet keys at https://www.binance.com/en/my/settings/api-management
# Mainnet (real-money) credentials — only used when BINANCE_TESTNET=false.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Testnet credentials — used when BINANCE_TESTNET=true.
# BINANCE_DEMO_KEY / BINANCE_DEMO_SECRET are accepted as synonyms.
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=
# true = Binance testnet (fake money). false = REAL money. Leave true unless you know what you're doing.
BINANCE_TESTNET=true
# Public market data source (Binance is geo-blocked in some regions, e.g. US).
# Options: binance | kraken | coinbase (any ccxt exchange id).
MARKET_DATA_EXCHANGE=binance

# ===== Anthropic Claude =====
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ===== Trading =====
TRADING_SYMBOL=BTC/USDT
TRADING_TIMEFRAME=15m
DEFAULT_MODE=paper            # signals | paper | live
SCAN_INTERVAL_SECONDS=60
USE_AI_CONFIRMATION=true

# ===== Paper trading =====
PAPER_STARTING_USDT=10000
PAPER_FEE_BPS=10              # 10 bps = 0.10%

# ===== Live trading safety =====
LIVE_MAX_ORDER_USDT=50        # hard cap per order

# ===== Strategy knobs =====
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
MA_FAST=20
MA_SLOW=50

# ===== Infra =====
DATABASE_URL=sqlite+aiosqlite:///./trader.db
CORS_ORIGINS=http://localhost:3000
